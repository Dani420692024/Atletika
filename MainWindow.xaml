<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atletika"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="KozepSzoveg" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BalSzoveg" TargetType="TextBlock">
            <Setter Property="Margin" Value="8, 0, 0, 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" RowDefinitions="Auto, *, Auto" ColumnDefinitions="410, *">

        <!-- Fejléc -->
        <StackPanel Grid.ColumnSpan="2" Margin="0, 0, 0, 16">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A"/>
        </StackPanel>

        <!-- Bal panel: Új versenyző -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0, 0, 20, 0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Új versenyző" FontSize="16" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,12"/>
                <Button x:Name="btnRegisztral" Click="Regisztral_Click" DockPanel.Dock="Bottom" Content="REGISZTRÁL" Height="36" Background="#DDEBFA" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0, 12, 0, 0"/>
                <StackPanel>
                    <TextBlock Text="Versenyző neve:" Margin="0, 0, 0, 4"/>
                    <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="6,0" Margin="0, 0, 0, 12"/>

                    <TextBlock Text="Versenyszám:" Margin="0, 0, 0, 4"/>
                    <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False" SelectedIndex="-1" VerticalContentAlignment="Center" Margin="0, 0, 0, 12">
                        <ComboBoxItem Content="100 m"/>
                        <ComboBoxItem Content="200 m"/>
                        <ComboBoxItem Content="400 m"/>
                        <ComboBoxItem Content="800 m"/>
                        <ComboBoxItem Content="1500 m"/>
                        <ComboBoxItem Content="Távolugrás"/>
                        <ComboBoxItem Content="Magasugrás"/>
                        <ComboBoxItem Content="Súlylökés"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Nem:" VerticalAlignment="Center" Margin="0, 0, 28, 0"/>
                        <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" VerticalContentAlignment="Center" Margin="0, 0, 40, 0"/>
                        <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0, 0, 0, 4" ColumnDefinitions="*, Auto">
                        <TextBlock Text="Életkor:" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtEletkor" Grid.Column="1" Text="18 év" FontWeight="Bold" Foreground="#1F5A9E" VerticalAlignment="Center" Margin="0, 0, 12, 0"/>
                    </Grid>
                    <Slider x:Name="sldEletkor" ValueChanged="Eletkor_Valtozott" Minimum="18" Maximum="90" Value="18" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0, 0, 0, 4"/>

                    <Grid Margin="0,0,0,12" ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="18" Foreground="#52657A" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="90" Foreground="#52657A" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D" Margin="0, 0, 0, 4"/>
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs (OR)" IsChecked="False" Margin="0, 0, 0, 4"/>
                    <CheckBox x:Name="chkVB" Content="Világcsúcs (VR)" IsChecked="False" Margin="0, 0, 0, 4"/>
                    <CheckBox x:Name="chkEB" Content="Európa-csúcs (ER)" IsChecked="False" Margin="0, 0, 0, 12"/>

                    <Grid Margin="0, 0, 0, 4" ColumnDefinitions="Auto, *">
                        <TextBlock Text="Igényelt rajtszám:" VerticalAlignment="Center" Margin="0, 0, 12, 0"/>
                        <TextBox x:Name="txtRajtszam" Grid.Column="1" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="6, 0"/>
                    </Grid>
                    <TextBlock Text="Üres mező: automatikus kiosztás." Foreground="#52657A" FontSize="12" Margin="0, 8, 0, 0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Jobb panel: Regisztrált versenyzők -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Regisztrált versenyzők" FontSize="16" FontWeight="Bold" Foreground="#19324D" Margin="0, 0, 0, 12"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0, 0, 0, 16">
                    <TextBlock Text="Eredményszűrő:" Width="150" Foreground="#19324D" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbRekordSzuro" SelectionChanged="Szuro_Valtozott" Width="360" Height="32" IsEditable="False" VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="Összes"/>
                        <ComboBoxItem Content="OR - olimpiai csúcs"/>
                        <ComboBoxItem Content="VR - világcsúcs"/>
                        <ComboBoxItem Content="ER - Európa-csúcs"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0, 12, 0, 0">
                    <TextBlock Text="OR = olimpiai csúcs" Foreground="#52657A" FontSize="12" Margin="0, 0, 24, 0"/>
                    <TextBlock Text="VR = világcsúcs" Foreground="#52657A" FontSize="12" Margin="0, 0, 24, 0"/>
                    <TextBlock Text="ER = Európa-csúcs" Foreground="#52657A" FontSize="12"/>
                </StackPanel>

                <DataGrid x:Name="dgVersenyzok"
                          ItemsSource="{Binding Versenyzok, Mode=OneWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E4EAF1"
                          RowHeight="32"
                          AlternationCount="2"
                          RowBackground="White"
                          AlternatingRowBackground="#F4F7FB"
                          Background="White"
                          BorderBrush="#D4DDE7"
                          BorderThickness="1">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D9E8F8"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#19324D"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D9E8F8"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#19324D"/>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#19324D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Height" Value="38"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Binding="{Binding Rajtszam, Mode=OneWay}" Width="88" ElementStyle="{StaticResource KozepSzoveg}"/>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev, Mode=OneWay}" Width="*" ElementStyle="{StaticResource BalSzoveg}"/>
                        <DataGridTextColumn Header="Versenyszám" Binding="{Binding Versenyszam, Mode=OneWay}" Width="160" ElementStyle="{StaticResource BalSzoveg}"/>
                        <DataGridTextColumn Header="Nem" Binding="{Binding Nem, Mode=OneWay}" Width="70" ElementStyle="{StaticResource KozepSzoveg}"/>
                        <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor, Mode=OneWay}" Width="80" ElementStyle="{StaticResource KozepSzoveg}"/>
                        <DataGridCheckBoxColumn Header="OR" Binding="{Binding OR, Mode=OneWay}" Width="80"/>
                        <DataGridCheckBoxColumn Header="VR" Binding="{Binding VR, Mode=OneWay}" Width="80"/>
                        <DataGridCheckBoxColumn Header="ER" Binding="{Binding ER, Mode=OneWay}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16, 10" Margin="0, 16, 0, 0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock x:Name="txtLetszam" Text="Látható: 0 / Összesen: 0" Foreground="#52657A" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnMentes" Click="Mentes_Click" Content="FÁJLBA MENTÉS" Height="32" Width="210" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnBetoltes" Click="Betoltes_Click" Content="FÁJLBÓL BETÖLTÉS" Height="32" Width="210" VerticalContentAlignment="Center" Margin="16, 0, 0, 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
